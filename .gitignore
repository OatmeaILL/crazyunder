# ==========================================
# 1. 临时文件与第三方工具缓存 (极易误传！)
# ==========================================
# 本地临时脚本/工具产生的库文件 (如 ffmpeg, pydub 等 Python 库)
临时文件/

# Trae IDE 的本地 AI 规格/任务缓存文件
.trae/

# ==========================================
# 2. 游戏运行时数据与本地存档 (极其重要)
# ==========================================
# 本地游戏存档 (包含成就、灵魂之忆、3个槽位存档等，绝对不能上传)
saves/
*.dat

# 运行时动态生成的资源 (如 TextureGenerator 过程化生成的贴图)
assets/generated/

# 运行日志文件
*.log
logs/

# ==========================================
# 3. 构建产物与中间文件
# ==========================================
# CMake 构建目录 (包含编译产物、复制进去的 sound/ 和 dll)
build/
out/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json
Makefile
CMakeUserPresets.json

# 可执行与中间文件
*.exe
*.obj
*.o
*.pdb
*.ilk
*.dll
*.lib
*.a
*.so
*.dylib

# Visual Studio 默认输出目录
x64/
x86/

# ==========================================
# 4. IDE / 编辑器 / 工具配置
# ==========================================
.vs/
.vscode/
.idea/
*.user
*.suo
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.VC.db
.cache/
*.swp
*~

# ==========================================
# 5. 包管理与第三方依赖
# ==========================================
vcpkg_installed/
_deps/
packages/

# ==========================================
# 6. 操作系统垃圾文件
# ==========================================
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store